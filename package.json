  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "bundle": "node scripts/bundle.js",
    "bundle:watch": "node scripts/bundle.js --watch",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.js\"",
    "test": "npm run compile && mocha",
    "sync-manifest": "npm run compile && node scripts/sync-manifest.js",
    "vscode:prepublish": "npm run bundle",
    "package": "npm run compile && npm run lint && npm test && npm run bundle && node scripts/smoke-test.js && vsce package --no-dependencies",
    "clean": "rm -rf out dist *.vsix",
    "smoke": "npm run bundle && node scripts/smoke-test.js",
    "check-manifest": "npm run compile && node scripts/sync-manifest.js --check"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.10",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "mocha": "^11.0.1",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.2"
  }
